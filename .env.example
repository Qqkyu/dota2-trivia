# Optional: the game works without Pusher, but these values enable live vote
# broadcasts between connected browsers. Vote totals are still available through
# the local Next.js API when these are left blank.
NEXT_PUBLIC_PUSHER_APP_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
PUSHER_APP_ID=
PUSHER_APP_SECRET=

# Production storage. When DATABASE_URL is set, votes, duplicate protection,
# reports, and calibration aggregates use Postgres transactionally. Leave it
# blank for the zero-config local JSON store.
DATABASE_URL=
DATABASE_POOL_SIZE=5

# Optional. Defaults to .data/queue-arcade-votes.json. Keep this on a
# persistent volume when running the Node server in production.
ARCADE_DATA_FILE=

# Raw synchronized rounds are disposable after their crowd reveal. Durable
# per-question aggregates and reports are retained separately.
ARCADE_ROUND_RETENTION_HOURS=2

# Optional local-development alpha file. Production alpha summaries use DATABASE_URL.
ARCADE_ALPHA_DATA_FILE=

# Production readiness rejects the local file backend unless a deployment with
# a persistent single-instance disk opts in deliberately.
ARCADE_ALLOW_FILE_STORE=false

# Optional private salt used before anonymous player IDs are written to disk.
ARCADE_VOTER_SALT=

# Canonical public origin and a separate private secret for signed Steam login
# state and session cookies. HTTPS is required outside localhost.
ARCADE_APP_URL=http://localhost:3000
ARCADE_AUTH_SECRET=

# Country or countries where connected profile data is stored. Required in
# production by the Steam Web API terms; for example: Poland.
ARCADE_DATA_COUNTRIES=

# Optional. Steam OpenID sign-in works without this; setting a private Steam
# Web API key enriches connected profiles with their current name and avatar.
STEAM_WEB_API_KEY=

# Optional comma- or space-separated SteamIDs allowed to resolve the protected
# question review queue. These must be 17-digit SteamID64 values.
ARCADE_REVIEWER_STEAM_IDS=

# Optional local-development account file. Production accounts use DATABASE_URL.
ARCADE_ACCOUNT_DATA_FILE=
