# Next development reads .env.local. Production commands read exported variables
# or the host's secret environment; do not commit a populated environment file.

# Supported public deployment: one long-running Node instance with Postgres.
# Run pnpm db:migrate with the migration role before deploying the runtime role.
DATABASE_URL=
DATABASE_POOL_SIZE=5
ARCADE_AUTO_MIGRATE=false

# Canonical public origin. HTTPS is required except for local verification.
ARCADE_APP_URL=http://localhost:3000

# REQUIRED in production: generate two separate random values of at least
# 32 characters. Keep them stable across deploys. Never reuse one for the other.
ARCADE_VOTER_SALT=
ARCADE_AUTH_SECRET=

# Actual countries where connected profile data and backups are stored.
# This value is displayed in /privacy. Include all locations that apply.
ARCADE_DATA_COUNTRIES=

# Optional enrichment of Steam profile names/avatars. OpenID works without it.
STEAM_WEB_API_KEY=

# Optional comma- or space-separated reviewer SteamID64 values (17 digits each).
ARCADE_REVIEWER_STEAM_IDS=

# Set an explicit policy. none ignores all forwarded headers and shares one
# conservative address budget. Use it for local checks and hosted verification.
# Enable cf-connecting-ip, x-real-ip, or x-forwarded-for only after proving that
# the ingress supplies the client address and cannot be bypassed.
# See docs/ingress-verification.md and docs/operations.md.
ARCADE_TRUST_PROXY=none

# Raw votes/rounds expire after this many hours; cleanup runs every minute while
# the app runs. Use an independent hourly cleanup job if the host sleeps/stops.
# Alpha sessions expire after 30 days. Aggregates and account results persist.
ARCADE_ROUND_RETENTION_HOURS=2

# Local JSON paths. Leave empty for .data defaults during development.
# Production rejects file storage unless explicitly opted in; use a persistent
# volume and exactly one process if this exception is required.
ARCADE_ALLOW_FILE_STORE=false
ARCADE_DATA_FILE=
ARCADE_ALPHA_DATA_FILE=
ARCADE_ACCOUNT_DATA_FILE=
