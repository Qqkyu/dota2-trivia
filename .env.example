# Optional: the game works without Pusher, but these values enable live vote
# broadcasts between connected browsers. Vote totals are still available through
# the local Next.js API when these are left blank.
NEXT_PUBLIC_PUSHER_APP_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
PUSHER_APP_ID=
PUSHER_APP_SECRET=

# Production storage. When DATABASE_URL is set, votes, duplicate protection,
# reports, and calibration aggregates use Postgres transactionally. Leave it
# blank for the zero-config local JSON store.
DATABASE_URL=
DATABASE_POOL_SIZE=5

# Optional. Defaults to .data/queue-arcade-votes.json. Keep this on a
# persistent volume when running the Node server in production.
ARCADE_DATA_FILE=

# Raw synchronized rounds are disposable after their crowd reveal. Durable
# per-question aggregates and reports are retained separately.
ARCADE_ROUND_RETENTION_HOURS=2

# Production readiness rejects the local file backend unless a deployment with
# a persistent single-instance disk opts in deliberately.
ARCADE_ALLOW_FILE_STORE=false

# Optional private salt used before anonymous player IDs are written to disk.
ARCADE_VOTER_SALT=
