# Optional: the game works without Pusher, but these values enable live vote
# broadcasts between connected browsers. Vote totals are still available through
# the local Next.js API when these are left blank.
NEXT_PUBLIC_PUSHER_APP_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
PUSHER_APP_ID=
PUSHER_APP_SECRET=

# Optional. Defaults to .data/queue-arcade-votes.json. Keep this on a
# persistent volume when running the Node server in production.
ARCADE_DATA_FILE=

# Optional private salt used before anonymous player IDs are written to disk.
ARCADE_VOTER_SALT=
