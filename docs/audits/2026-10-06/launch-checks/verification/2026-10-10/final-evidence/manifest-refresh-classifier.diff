+              "scope": "Historical source-review change record. Verify exact manifest blobs, input change lists and changed input/evidence blobs."}
+    try:
+        if not is_manifest_refresh_record(document):
+            raise ValueError("Invalid manifest refresh record shape")
+        manifests = []
+        for revision, key, count_key in zip(revisions, ("previousManifestSha256", "currentManifestSha256"), ("previousFileCount", "currentFileCount")):
+            raw = read_blob(revision, "docs/content-review.json")
+            manifest = json.loads(raw)
+            if digest(raw) != document[key] or len(manifest["files"]) != document[count_key]:
+                raise ValueError("Linked source manifest hash or file count differs")
+            manifests.append(manifest)
+            result["checkedBlobs"].append({"commit": revision, "path": "docs/content-review.json", "sha256": digest(raw)})
+        before, after = manifests
+        changed = sorted(name for name in set(before["files"]) | set(after["files"]) if before["files"].get(name) != after["files"].get(name))
+        added = sorted(set(after["files"]) - set(before["files"]))
+        missing = sorted(set(before["files"]) - set(after["files"]))
+        if sorted(document["changedReviewInputs"]) != changed or document.get("missingReviewInputs") != missing:
+            raise ValueError("Recorded input changes differ from linked manifests")
+        if "addedReviewInputs" in document and sorted(document["addedReviewInputs"]) != added:
+            raise ValueError("Recorded added inputs differ from linked manifests")
+        if after["reviewedAt"] != document.get("currentReviewedAt"):
