+def is_manifest_refresh_record(document):
+    """Source-review change records contain hashes, but no file inventory."""
+    if not isinstance(document, dict) or "files" in document or not isinstance(document.get("changedReviewInputs"), list):
+        return False
+    for key in ("changedReviewInputs", "addedReviewInputs", "missingReviewInputs"):
+        if key in document:
+            values = document[key]
+            if not isinstance(values, list) or any(not isinstance(value, str) for value in values) or len(values) != len(set(values)):
+                return False
+    for key in ("previousFileCount", "currentFileCount"):
+        if type(document.get(key)) is not int or document[key] < 0:
+            return False
+    return all(isinstance(document.get(key), str) and HEX.fullmatch(document[key])
+               for key in ("previousManifestSha256", "currentManifestSha256"))
+
