+def revision_blob(commit, path):
+    name = PurePosixPath(path)
+    if name.is_absolute() or ".." in name.parts or ":" in path or "\\" in path:
+        raise ValueError("Unsafe revision file path")
+    env = {key: value for key, value in os.environ.items() if not key.startswith("GIT_")}
+    env.update(GIT_OPTIONAL_LOCKS="0", GIT_NO_REPLACE_OBJECTS="1")
+    result = subprocess.run(["git", "-c", "core.hooksPath=/dev/null", "-c", "core.fsmonitor=false", "cat-file", "blob", commit + ":" + path],
+                            cwd=REPO, env=env, capture_output=True, timeout=10, check=False)
+    if result.returncode:
+        raise ValueError("Revision file is unavailable")
+    return result.stdout
+
